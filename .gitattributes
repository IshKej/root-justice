# Normalize line endings so cross-platform checkouts are stable.
# Shell scripts and unit files MUST be LF or they break on Linux.
* text=auto eol=lf

# Windows-native scripts stay CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicitly LF for deployment scripts/units.
*.sh text eol=lf
*.service text eol=lf
Dockerfile text eol=lf

# Treat common binaries as binary.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
