# Root Justice service configuration. Copy to /etc/root-justice/root-justice.env
# and edit. Defaults are intentionally SAFE: loopback-bound and log-only.

# Interface/port the shield listens on. Use 0.0.0.0 only when it sits in front of
# the app it protects, behind your own TLS terminator.
RJ_HOST=127.0.0.1
RJ_PORT=8080

# Evidence ledger path (service account must own this; systemd StateDirectory sets it).
RJ_EVIDENCE=/var/lib/root-justice/evidence_ledger.jsonl

# Extra flags. LEAVE EMPTY for log-only (observe + record, deny nothing).
# To enforce (serve the warning banner + block + tarpit + decoy), set: --enforce
#
# Common options (all optional):
#   --trusted-proxy 10.0.0.0/8      believe X-Forwarded-For only from these (repeatable)
#   --upstream http://127.0.0.1:9000  reverse-proxy clean traffic to your real app
#   --tls-cert /path/cert.pem --tls-key /path/key.pem   terminate HTTPS
#   --allowlist /etc/root-justice/allow.txt   never flag monitors/CI (IP/CIDR)
#   --intel /etc/root-justice/blocklist.txt   threat-intel feed, file or URL (repeatable)
#   --db /var/lib/root-justice/state.sqlite3  persist blocks across restarts
#   --webhook https://hooks.example/...       alert on high/critical streams
#   --no-decoy  --no-tarpit         opt out of deception (both on by default in --enforce)
#
# Example enforcing config:
#   RJ_EXTRA_ARGS=--enforce --trusted-proxy 10.0.0.0/8 --db /var/lib/root-justice/state.sqlite3 --allowlist /etc/root-justice/allow.txt
RJ_EXTRA_ARGS=
